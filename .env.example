# Server
PORT=3000

# Supabase (server only; never expose this key to the browser)
# Obtain both values from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Azure OpenAI chat model
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_KEY=your-api-key

# Azure OpenAI embeddings
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBED_API_VERSION=2024-02-01

# Library PDF uploads (Azure OpenAI Files)
# Optional: defaults to 100 MiB (104857600) when unset.
LIBRARY_PDF_MAX_BYTES=104857600
# AZURE_OPENAI_FILES_TIMEOUT_SECONDS=120

# Zilliz Cloud
ZILLIZ_URI=https://your-cluster.api.region.zillizcloud.com
ZILLIZ_TOKEN=your-zilliz-api-key

# === Optional integrations ===

# OpenAlex citation lookup. Free key: https://openalex.org/settings/api
# Citation endpoints are unavailable when this is empty.
OPENALEX_API_KEY=

# Google Cloud Logging (optional). Path to a GCP service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=
